# ==============================================================================
# OptiWay Backend — Plantilla de variables de entorno
# Copia este archivo como .env y completa los valores sensibles en tu entorno local.
# ==============================================================================

# --- Servidor Spring Boot ---
PORT=8080
# ALLOWED_ORIGINS=http://localhost:*,http://127.0.0.1:*,https://opti-way-frontend.vercel.app,https://*.vercel.app,https://*.onrender.com
SWAGGER_ENABLED=true
LOG_LEVEL=INFO
APP_LOG_LEVEL=INFO

# --- Base de datos PostgreSQL (Supabase) ---
DB_PASSWORD=tu_db_password

# --- Supabase Auth ---
SUPABASE_PROJECT_REF=tu_project_ref
SUPABASE_URL=https://tu_project_ref.supabase.co
SUPABASE_SERVICE_ROLE_KEY=tu_service_role_key
SUPABASE_ANON_KEY=tu_supabase_anon_key
SUPABASE_INVITE_REDIRECT_URL=http://localhost:8080/set-password.html

# --- Credenciales de prueba para tests/api/*.py ---
BASE_URL=http://localhost:8080
AUTH_TOKEN=
ADMIN_EMAIL=admin@empresa.com
ADMIN_PASSWORD=
PLANIFICADOR_EMAIL=ana@empresa.com
PLANIFICADOR_PASSWORD=
TIENDA_EMAIL=carlos@empresa.com
TIENDA_PASSWORD=
CD_EMAIL=roberto@empresa.com
CD_PASSWORD=
